{
  "name": "@cyanheads/guardian-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for The Guardian Open Platform — journalism archive from 1999 to present with full article text.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/guardian-mcp-server#readme",
  "repository": "https://github.com/cyanheads/guardian-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "@cyanheads/guardian-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/guardian-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "GUARDIAN_API_KEY": ""
      }
    }
  }
}
