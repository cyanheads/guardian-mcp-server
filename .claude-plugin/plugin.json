{
  "name": "guardian-mcp-server",
  "version": "0.1.2",
  "description": "Search, browse, and retrieve full article text from The Guardian's journalism archive (1999–present) via MCP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/guardian-mcp-server#readme",
  "repository": "https://github.com/cyanheads/guardian-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "guardian-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/guardian-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "GUARDIAN_API_KEY": ""
      }
    }
  }
}
